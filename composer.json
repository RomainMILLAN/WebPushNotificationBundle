{
    "name": "romainmillan/web-push-notification",
    "description": "Web Push notifications for Symfony and Laravel: subscription storage, VAPID delivery, SSRF-hardened transport and a ready-to-use service worker.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/RomainMILLAN/WebPushNotificationBundle",
    "support": {
        "issues": "https://github.com/RomainMILLAN/WebPushNotificationBundle/issues",
        "source": "https://github.com/RomainMILLAN/WebPushNotificationBundle",
        "docs": "https://github.com/RomainMILLAN/WebPushNotificationBundle/tree/main/docs"
    },
    "keywords": ["web-push", "push-notifications", "pwa", "vapid", "service-worker", "symfony", "symfony-bundle", "laravel"],
    "authors": [
        {
            "name": "Romain MILLAN"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-sodium": "*",
        "guzzlehttp/guzzle": "^7.9",
        "minishlink/web-push": "^10.1",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/string": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.11 || ^3.0",
        "doctrine/orm": "^2.17 || ^3.0",
        "masterminds/html5": "^2.7.5",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^6.4 || ^7.0",
        "symfony/clock": "^6.4 || ^7.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/css-selector": "^6.4 || ^7.0",
        "symfony/dom-crawler": "^6.4 || ^7.0",
        "symfony/error-handler": "^6.4.44 || ^7.4.17 || ^8.1.5",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/lock": "^6.4 || ^7.0",
        "symfony/messenger": "^6.4 || ^7.0",
        "symfony/notifier": "^6.4 || ^7.0",
        "symfony/rate-limiter": "^6.4 || ^7.0",
        "symfony/security-bundle": "^6.4 || ^7.0",
        "symfony/twig-bundle": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "Symfony: store subscriptions with Doctrine ORM",
        "symfony/messenger": "Symfony: deliver notifications asynchronously",
        "symfony/notifier": "Symfony: send web push through the Notifier component",
        "symfony/lock": "Symfony: serialize concurrent registrations (strict subscription quota)",
        "symfony/rate-limiter": "Symfony: required (the unsubscribe endpoint is always rate limited, anonymous subscriptions too)",
        "laravel/framework": "Laravel 12 integration (auto-discovered service provider)",
        "phpunit/phpunit": "Run Testing\\SubscriptionRepositoryContract against your own storage adapter"
    },
    "autoload": {
        "psr-4": {
            "RomainMillan\\WebPushNotification\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RomainMillan\\WebPushNotification\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RomainMillan\\WebPushNotification\\Bridge\\Laravel\\WebPushNotificationServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
